generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//// ENUMS ////

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  BLOCKED
}

enum UserRole {
  ADMIN
  NUTRITIONIST
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

//// MODELS ////

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(NUTRITIONIST)

  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?

  patients  Patient[]
  foodItems FoodItem[]

  // Workspace foundation (fase Consulta Clínica, corte 1) -- ver comentarios en Workspace.
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  firstName     String
  lastName      String
  sex           Sex
  birthDate     DateTime
  activityLevel ActivityLevel

  measurements     Measurement[]
  results          Result[]
  assessments      Assessment[]
  nutritionalPlans NutritionalPlan[]

  // Nullable en este commit (Migración A): PatientsService sigue autorizando
  // por userId sin cambios; workspaceId se backfillea para todo Patient
  // existente pero todavía no es la autoridad de acceso. La Migración B
  // (commit siguiente) lo convierte en NOT NULL una vez verificado el backfill.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

// ----------------------------------------------------------------------
// WORKSPACE (fundación multi-tenant -- corte 1 de la fase Consulta Clínica)
// ----------------------------------------------------------------------
// Introducido ahora, con MVP de un único Workspace PERSONAL por nutricionista,
// para que ClinicalEncounter (cortes posteriores) nazca ya con el eje de
// autorización correcto y no requiera una segunda migración masiva cuando
// existan centros. En este corte, Workspace es una fundación de datos --
// invisible para la aplicación: ningún endpoint lo crea, edita ni expone.
enum WorkspaceRole {
  OWNER
  PROFESSIONAL // sin uso en el MVP; preparado para centros con varios profesionales
}

enum WorkspaceType {
  PERSONAL
  CENTER // preparado en BD; sin UI/endpoints en este corte
}

model Workspace {
  id          String @id @default(uuid())
  ownerUserId String
  owner       User   @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])

  type     WorkspaceType @default(PERSONAL)
  name     String
  timezone String        @default("America/Santiago")

  members  WorkspaceMember[]
  patients Patient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Un mismo usuario puede tener como mucho un Workspace PERSONAL, pero podrá
  // ser owner de varios Workspace CENTER a futuro -- por eso NO se usa
  // `ownerUserId @unique` aquí. La restricción real vive en un índice único
  // parcial creado a mano en la migración (Prisma DSL no soporta índices
  // únicos parciales, mismo caso ya documentado para Assessment/NutritionalPlan):
  //   CREATE UNIQUE INDEX "Workspace_one_personal_per_owner"
  //     ON "Workspace" ("ownerUserId") WHERE "type" = 'PERSONAL';

  @@index([ownerUserId])
  @@index([type])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  role WorkspaceRole @default(OWNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Measurement {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  weightKg Float
  heightCm Float
  waistCm  Float?

  measuredAt DateTime

  createdAt DateTime @default(now())
}

model Result {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  bmi      Float
  bmiClass String
  tdeeKcal Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------
// PLANIFICACIÓN NUTRICIONAL
// ----------------------------------------------------------------------

enum PlanStatus {
  DRAFT
  FINALIZED
}

model NutritionalPlan {
  id        String    @id @default(uuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id])
  userId    String

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  status      PlanStatus @default(DRAFT)
  date        DateTime   @default(now())
  finalizedAt DateTime?

  // Copia congelada de measurements + results relevantes del Assessment al
  // momento de crear/recalcular el plan (para que el plan no cambie si la
  // Evaluación fuente se edita después).
  sourceSnapshot Json

  // Salida estructurada del motor de cálculo versionado: un objeto por
  // métrica (BMI, BODY_FAT_PERCENTAGE, BMR, TDEE, PROTEIN_G, CARBS_G, FAT_G,
  // FIBER_G, WATER_ML), cada uno con { value, unit, status, formulaUsed,
  // formulaVersion, engineVersion, statusCode?, statusLabel? }.
  calculationResults Json
  engineVersion      String

  // Última configuración enviada por la nutricionista (bmrFormulaId, pal,
  // targetWeightKg, macroMethod, macroPercents, fiberSourceId, waterSourceId).
  // Nullable porque es un campo aditivo -- filas previas a esta migración no
  // lo tendrán; el mapper de lectura hace `config ?? {}`.
  config Json?

  // Metadata de trazabilidad (fórmula/versión/referencia por métrica + fuentes
  // seleccionadas) congelada en el momento del cálculo -- nunca se reconstruye
  // consultando el registro de estrategias en una lectura (GET). Nullable
  // porque es aditivo; filas previas a esta migración devuelven metadata null
  // en vez de fabricar referencias dinámicas.
  calculationMetadata Json?
  calculatedAt        DateTime?

  // Legacy: se mantienen para no romper lecturas antiguas del frontend.
  // El backend ya no acepta contenido arbitrario del cliente aquí; se siguen
  // poblando como espejo de calculationResults por compatibilidad.
  patientValues Json?
  energyCalc    Json?
  macros        Json?
  micros        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([userId])
  @@index([assessmentId])
}

// ----------------------------------------------------------------------
// MÓDULO ALIMENTOS
// ----------------------------------------------------------------------

enum FoodSourceType {
  API_LIVE       // Búsqueda en tiempo real vía API (ej. USDA, Open Food Facts)
  API_CACHED     // Traído por API y almacenado localmente
  SEEDED         // Cargado desde CSV/JSON en seed o migración
  ADMIN_IMPORT   // Importado manualmente por admin de plataforma
  NUTRITIONIST   // Alimento personalizado creado por la nutricionista
}

model FoodSource {
  id          String         @id @default(uuid())
  code        String         @unique   // "USDA", "MINSAL_CL", "CUSTOM", etc.
  name        String                   // "USDA FoodData Central"
  region      String?                  // "CL", "US", "ES", "AR", "MX"
  type        FoodSourceType
  description String?
  url         String?                  // URL oficial de referencia
  lastSyncAt  DateTime?
  isActive    Boolean        @default(true)
  foods       FoodItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FoodItem {
  id         String     @id @default(uuid())
  sourceId   String
  source     FoodSource @relation(fields: [sourceId], references: [id])
  externalId String?    // ID original en la fuente (ej: FDC ID de USDA)

  name       String     // Nombre en idioma original
  nameEs     String?    // Traducción al español
  category   String?    // "Carnes", "Lácteos", "Cereales", etc.

  // Valores por 100 g / 100 ml
  energy     Float?     // kcal
  protein    Float?     // g
  carbs      Float?     // g
  fat        Float?     // g
  fiber      Float?     // g
  sugar      Float?     // g
  sodium     Float?     // mg

  // Nutrientes extendidos (calcio, hierro, vitaminas, etc.)
  nutrients  Json?

  // null = alimento global de la fuente
  // set  = alimento personalizado de una nutricionista
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])

  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([sourceId, externalId])
  @@index([name])
  @@index([nameEs])
  @@index([sourceId])
  @@index([category])
  @@index([userId])
}

// ----------------------------------------------------------------------
// 1. CATÁLOGOS FORMALES (Diccionarios base de la aplicación)
// ----------------------------------------------------------------------

enum MeasurementGroup {
  BASIC
  COMPOSITION
  SKINFOLD
  GIRTH
  CLINICAL_MARKER
}

enum MetricCategory {
  COMPOSITION
  INDEX
  DIAGNOSTIC
  ENERGY_REQUIREMENT
}

model MeasurementDefinition {
  id          String           @id
  group       MeasurementGroup
  name        String
  unit        String?
  description String?
  isActive    Boolean          @default(true)

  records MeasurementRecord[]
}

model MetricDefinition {
  id          String         @id
  name        String
  category    MetricCategory
  description String?
  isActive    Boolean        @default(true)

  results CalculatedResult[]
}

// ----------------------------------------------------------------------
// 2. NÚCLEO TRANSACCIONAL (Evaluación)
// ----------------------------------------------------------------------

enum AssessmentStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

model Assessment {
  id        String           @id @default(uuid())
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id])
  date      DateTime
  status    AssessmentStatus @default(DRAFT)
  completedAt DateTime?

  ageAtAssessmentMonths Int?
  populationGroup       String?
  specialProfile        String?
  clinicalProtocol      String?
  protocolVersion       String?

  measurements     MeasurementRecord[]
  results          CalculatedResult[]
  nutritionalPlans NutritionalPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status, date, completedAt])
}

model MeasurementRecord {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  definitionId String
  definition   MeasurementDefinition @relation(fields: [definitionId], references: [id])

  numericValue   Float?
  stringValue    String?
  metadataAsJson Json?

  measuredBy String?
  deviceUsed String?

  createdAt DateTime @default(now())

  @@unique([assessmentId, definitionId])
  @@index([definitionId, assessmentId, createdAt])
}

// ----------------------------------------------------------------------
// 3. CAPA DE RESULTADOS
// ----------------------------------------------------------------------

enum ResultStatus {
  CALCULATED
  MISSING_DATA
  NOT_APPLICABLE
  PENDING_RULE
}

model CalculatedResult {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  metricId String
  metric   MetricDefinition @relation(fields: [metricId], references: [id])

  numericValue   Float?
  stringValue    String?
  metadataAsJson Json?

  status ResultStatus @default(CALCULATED)

  statusCode  String?
  statusLabel String?

  formulaUsed      String?
  formulaVersion   String?
  referenceTableId String?
  engineVersion    String?

  @@unique([assessmentId, metricId])
}
