generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//// ENUMS ////

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  BLOCKED
}

enum UserRole {
  ADMIN
  NUTRITIONIST
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

//// MODELS ////

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(NUTRITIONIST)

  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?

  patients  Patient[]
  foodItems FoodItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  firstName     String
  lastName      String
  sex           Sex
  birthDate     DateTime
  activityLevel ActivityLevel

  measurements      Measurement[]
  results           Result[]
  assessments       Assessment[]
  nutritionalPlans  NutritionalPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Measurement {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  weightKg Float
  heightCm Float
  waistCm  Float?

  measuredAt DateTime

  createdAt DateTime @default(now())
}

model Result {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  bmi      Float
  bmiClass String
  tdeeKcal Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------
// PLANIFICACIÓN NUTRICIONAL
// ----------------------------------------------------------------------

enum PlanStatus {
  DRAFT
  FINALIZED
}

model NutritionalPlan {
  id        String    @id @default(uuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id])
  userId    String

  status      PlanStatus @default(DRAFT)
  date        DateTime   @default(now())
  finalizedAt DateTime?

  patientValues Json?
  energyCalc    Json?
  macros        Json?
  micros        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([userId])
}

// ----------------------------------------------------------------------
// MÓDULO ALIMENTOS
// ----------------------------------------------------------------------

enum FoodSourceType {
  API_LIVE       // Búsqueda en tiempo real vía API (ej. USDA, Open Food Facts)
  API_CACHED     // Traído por API y almacenado localmente
  SEEDED         // Cargado desde CSV/JSON en seed o migración
  ADMIN_IMPORT   // Importado manualmente por admin de plataforma
  NUTRITIONIST   // Alimento personalizado creado por la nutricionista
}

model FoodSource {
  id          String         @id @default(uuid())
  code        String         @unique   // "USDA", "MINSAL_CL", "CUSTOM", etc.
  name        String                   // "USDA FoodData Central"
  region      String?                  // "CL", "US", "ES", "AR", "MX"
  type        FoodSourceType
  description String?
  url         String?                  // URL oficial de referencia
  lastSyncAt  DateTime?
  isActive    Boolean        @default(true)
  foods       FoodItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FoodItem {
  id         String     @id @default(uuid())
  sourceId   String
  source     FoodSource @relation(fields: [sourceId], references: [id])
  externalId String?    // ID original en la fuente (ej: FDC ID de USDA)

  name       String     // Nombre en idioma original
  nameEs     String?    // Traducción al español
  category   String?    // "Carnes", "Lácteos", "Cereales", etc.

  // Valores por 100 g / 100 ml
  energy     Float?     // kcal
  protein    Float?     // g
  carbs      Float?     // g
  fat        Float?     // g
  fiber      Float?     // g
  sugar      Float?     // g
  sodium     Float?     // mg

  // Nutrientes extendidos (calcio, hierro, vitaminas, etc.)
  nutrients  Json?

  // null = alimento global de la fuente
  // set  = alimento personalizado de una nutricionista
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])

  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([sourceId, externalId])
  @@index([name])
  @@index([nameEs])
  @@index([sourceId])
  @@index([category])
  @@index([userId])
}

// ----------------------------------------------------------------------
// 1. CATÁLOGOS FORMALES (Diccionarios base de la aplicación)
// ----------------------------------------------------------------------

enum MeasurementGroup {
  BASIC
  COMPOSITION
  SKINFOLD
  GIRTH
  CLINICAL_MARKER
}

enum MetricCategory {
  COMPOSITION
  INDEX
  DIAGNOSTIC
  ENERGY_REQUIREMENT
}

model MeasurementDefinition {
  id          String           @id
  group       MeasurementGroup
  name        String
  unit        String?
  description String?
  isActive    Boolean          @default(true)

  records MeasurementRecord[]
}

model MetricDefinition {
  id          String         @id
  name        String
  category    MetricCategory
  description String?
  isActive    Boolean        @default(true)

  results CalculatedResult[]
}

// ----------------------------------------------------------------------
// 2. NÚCLEO TRANSACCIONAL (Evaluación)
// ----------------------------------------------------------------------

enum AssessmentStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

model Assessment {
  id        String           @id @default(uuid())
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id])
  date      DateTime
  status    AssessmentStatus @default(DRAFT)

  ageAtAssessmentMonths Int?
  populationGroup       String?
  specialProfile        String?
  clinicalProtocol      String?
  protocolVersion       String?

  measurements MeasurementRecord[]
  results      CalculatedResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeasurementRecord {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  definitionId String
  definition   MeasurementDefinition @relation(fields: [definitionId], references: [id])

  numericValue   Float?
  stringValue    String?
  metadataAsJson Json?

  measuredBy String?
  deviceUsed String?

  @@unique([assessmentId, definitionId])
}

// ----------------------------------------------------------------------
// 3. CAPA DE RESULTADOS
// ----------------------------------------------------------------------

enum ResultStatus {
  CALCULATED
  MISSING_DATA
  NOT_APPLICABLE
  PENDING_RULE
}

model CalculatedResult {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  metricId String
  metric   MetricDefinition @relation(fields: [metricId], references: [id])

  numericValue   Float?
  stringValue    String?
  metadataAsJson Json?

  status ResultStatus @default(CALCULATED)

  statusCode  String?
  statusLabel String?

  formulaUsed      String?
  formulaVersion   String?
  referenceTableId String?
  engineVersion    String?

  @@unique([assessmentId, metricId])
}
